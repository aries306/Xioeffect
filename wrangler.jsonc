{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiohq",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }

  // Production database binding:
  // 1. Create Hyperdrive against the existing PostgreSQL database:
  //    npx wrangler hyperdrive create xiohq-db --connection-string="$DATABASE_URL"
  // 2. Add the returned ID as:
  //    "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID>" }]
  //
  // Do not commit DATABASE_URL or other credentials.
}
