{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zuna",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "APP_ENV": "production"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "21a940560ded47ea8f0ed10eda49dbe9"
    }
  ],
  "preview_urls": false,
  "previews": {},
  "env": {
    "staging": {
      "name": "exelta-staging",
      "vars": {
        "APP_ENV": "staging",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_YmVsb3ZlZC1pbXBhbGEtNjgzMS5jbGVyay5hY2NvdW50cy5kZXYk"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "6b65f8e46ab34ec39b87abd9fdbf5636"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  },
  "account_id": "6266f92b054b68ec69ff619d3869f195"
}
