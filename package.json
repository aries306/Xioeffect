{
  "name": "xio-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:vinext": "vinext dev",
    "build:vinext": "vinext build",
    "start:vinext": "vinext start",
    "preview:cloudflare": "npm run build:vinext && npx wrangler dev",
    "deploy:cloudflare": "npm run build:vinext && npx wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "16.2.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.9",
    "zod": "4.1.12",
    "@clerk/nextjs": "6.36.4",
    "stripe": "18.5.0",
    "@neondatabase/serverless": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@cloudflare/vite-plugin": "1.54.7",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.5",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
