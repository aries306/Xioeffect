{
  "name": "xio-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dev:vinext": "vinext dev",
    "build:vinext": "vinext build",
    "start:vinext": "vinext start",
    "preview:cloudflare": "npm run build:vinext && npx wrangler dev",
    "preview": "bash scripts/preview.sh",
    "deploy:cloudflare": "npm run build:vinext && npx wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging npm run build:vinext && npx wrangler deploy",
    "dev:next": "next dev -p 3000 -H 0.0.0.0",
    "build:next": "next build",
    "start:next": "next start",
    "validate:staging": "node scripts/validate-staging-config.mjs",
    "test:acceptance": "node --test tests/live-acceptance.mjs",
    "validate:staging-build": "node scripts/validate-staging-build.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "6.36.4",
    "next": "16.2.5",
    "postgres": "^3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "stripe": "18.5.0",
    "vinext": "1.0.0-beta.9",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.5",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.157.0"
  },
  "allowScripts": {
    "@clerk/shared": true,
    "esbuild": true,
    "sharp": true,
    "unrs-resolver": true,
    "workerd": true
  }
}
